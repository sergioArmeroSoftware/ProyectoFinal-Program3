        </mxCell>
        <mxCell id="r_move" value="1 registra 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d6b656;endArrow=block;endFill=1;fontSize=12;fontColor=#263746;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="resource" target="movement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_note" value="&lt;b&gt;Referencias y reglas&lt;/b&gt;&lt;br&gt;Las relaciones con usuarios, zonas y personas se resuelven por sus IDs (por ejemplo, &lt;i&gt;zona_codigo&lt;/i&gt;, &lt;i&gt;responsable_id&lt;/i&gt; y &lt;i&gt;persona_id&lt;/i&gt;); no se trazan aquí para evitar cruces entre contextos.&lt;br&gt;La ocupación del albergue se calcula desde sus estancias activas. El GenServer valida disponibilidad y capacidad antes de guardar un cambio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1520" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
