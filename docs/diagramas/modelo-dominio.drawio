        <mxCell id="user_activity_link" value="1 genera 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=block;endFill=1;fontSize=12;fontColor=#263746;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="activity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_note" value="&lt;b&gt;Persistencia y referencias&lt;/b&gt;&lt;br&gt;Los structs se almacenan en mapas indexados por ID dentro del estado del GenServer; los historiales se conservan en listas ordenadas. &lt;i&gt;zona_codigo&lt;/i&gt;, &lt;i&gt;persona_id&lt;/i&gt;, &lt;i&gt;usuario_id&lt;/i&gt; y los IDs de reportes conectan registros con los contextos de la página 1.&lt;br&gt;El modelo describe datos del dominio Elixir y persistencia en archivos de texto; no define tablas MySQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="1520" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
